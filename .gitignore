
*.pyc

*.pkl

# Golden reference data that IS tracked on purpose: the test suite loads
# testing/results/*.pkl through do_mpc.data.load_results() and the documentation
# build reads documentation/source/results/*.pkl, so the blanket "*.pkl" above
# must not apply to them. The byproduct rules further below are more specific
# and come later, so they still win for files the tests write at runtime.
!testing/results/*.pkl
!documentation/source/results/*.pkl

*/.ipynb_checkpoints/

docs/source/.ipynb_checkpoints/

documentation/build/

documentation/source/.ipynb_checkpoints/

documentation/source/_autosummary/

documentation/source/api/

*.DS_Store

documentation/source/release_notes.md

documentation/source/example_gallery/.ipynb_checkpoints/

examples/conti_discrete/main.py

testing/results/test_save.pkl

examples/**/*.pkl
# Tracked golden result of the CSTR example. This must stay below
# 'examples/**/*.pkl' - the last matching pattern wins in .gitignore.
!examples/CSTR/results/CSTR_robust_MPC.pkl
documentation/source/example_gallery/**/*.pkl
!documentation/source/example_gallery/sampling_notebook/my_dataset/*.pkl
!documentation/source/example_gallery/training_notebook/results_my_dataset/*.pkl
testing/sample_results/*.pkl

# Trainer / Sampler output of examples/CSTR_approximate_mpc (approx_mpc.pth,
# training_history.json/png, hyperparameters.json, ...). Regenerable. It lives in
# a subdirectory, so a single-level "training/*" pattern would not match it.
training/

testing/model.pkl

.venv/

.ruff_cache

# temporary ONNX files written by the sysid tests / examples
testing/_onnx_tmp_*/
examples/lstm_surrogate_model/_tmp/

__pycache__/

# byproducts of test_CSTR_approx_MPC.py (Sampler / Trainer default dirs,
# relative to the testing/ working directory). Fully regenerable.
testing/sampling/
testing/training/

# Python packaging build artifacts
# (note: 'documentation/build/' above is path-specific and does NOT cover the
#  root build/ that setuptools creates)
dist/
build/
*.egg-info/
.eggs/

# IDE project settings (local to each developer)
.idea/

# byproduct of test_lstm_surrogate_model.py (do_mpc.data.save_results output,
# regenerated on every run; the golden file results_lstm_surrogate.pkl IS tracked)
testing/results/test_save_lstm.pkl

# written by testing/test_graphics.py next to the golden results
testing/results/test_graphics_tmp.pkl
